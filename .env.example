# ════════════════════════════════════════════════════════════════
# SUPABASE (Get these from: https://supabase.com/dashboard/project/_/settings/api)
# ════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your_anon_key_here

# SERVER ONLY — never expose to browser! Used for admin operations.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your_service_role_key_here

# ════════════════════════════════════════════════════════════════
# ANTHROPIC (Claude API) — SERVER ONLY
# https://console.anthropic.com/settings/keys
# ════════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ════════════════════════════════════════════════════════════════
# UPSTASH REDIS (for rate limiting) — Optional but strongly recommended
# Free tier: https://upstash.com/
# ════════════════════════════════════════════════════════════════
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXX...

# ════════════════════════════════════════════════════════════════
# APP CONFIG
# ════════════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=حلول

# Daily AI chat message limit per user
CHAT_DAILY_LIMIT=50
# Per-minute rate limit (anti-spam)
CHAT_PER_MINUTE_LIMIT=5

# Same idea for the GlobalAI overlay (/api/ai, /api/ai-quiz)
AI_DAILY_LIMIT=80
AI_PER_MINUTE_LIMIT=10

# Replies per person per day from the PAID provider (Anthropic). Free
# providers are always tried first and never count against this; the paid one
# is only offered while allowance remains. Counted against a signed httpOnly
# device cookie AND the caller IP, so clearing site data doesn't reset it.
PAID_AI_DAILY_LIMIT=5

# ════════════════════════════════════════════════════════════════
# ADMIN PANEL — /admin
# ════════════════════════════════════════════════════════════════
# No separate secret needed anymore — /admin now checks the logged-in
# user's own Supabase session and requires profile.role IN ('admin',
# 'moderator'). Promote yourself after signing up normally:
#   UPDATE profiles SET role = 'admin' WHERE id = (SELECT id FROM auth.users WHERE email = 'you@example.com');

# ════════════════════════════════════════════════════════════════
# VERCEL BLOB — File Storage
# Create at: Vercel Dashboard → Storage → Create Database → Blob
# ════════════════════════════════════════════════════════════════
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder

# ════════════════════════════════════════════════════════════════
# WEB PUSH (device notifications that arrive when the app is closed)
# Generate the pair ONCE, then paste below (public key goes in TWO vars):
#   npx web-push generate-vapid-keys
# The NEXT_PUBLIC_ one is safe in the browser; VAPID_PRIVATE_KEY is server
# only. Requires running migration 011_push_subscriptions.sql in Supabase.
# If these are unset, push simply stays off — the rest of the app is fine.
# ════════════════════════════════════════════════════════════════
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact shown to push services (mailto: or https URL)
VAPID_SUBJECT=mailto:you@example.com
